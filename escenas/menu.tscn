[node name="Texto" type="Label" parent="Interfaz/Pantalla/PanelComoJugar/Caja"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 19
text = "Eres el árbitro y la barra invadió la cancha.
Sobrevive a las 8 oleadas y llega al túnel de camerinos.

Moverse: A  D  o flechas        Saltar: Espacio
Tarjeta: apunta con el mouse y clic izquierdo
Aerosol: clic derecho (ciega a la barra 3 s)
Esquivar: Shift        Rodar: Q
Hacer ruido: R        Interactuar: mantener E
Pausa: Esc

Violeta y \"!\": ese barrista va a atacar.
En el tiempo muerto toma agua para recuperar energía."
autowrap_mode = 3

